{
	"name": "gwttr",
	"description": "Golang wttr.in client",
	"scripts": {
		"format": "prettier --write",
		"format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
		"md:lint": "markdownlint-cli2",
		"prose": "vale --no-exit --glob='!{styles/**,node_modules/**,CHANGELOG.md}' .",
		"prepare": "lefthook install",
		"lint": "biome check",
		"lint:fix": "biome check --write"
	},
	"author": "Ryan Kes <ryan@ryankes.eu>",
	"license": "GPL-3.0-only",
	"trustedDependencies": [
		"lefthook"
	],
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@commitlint/cli": "21.2.1",
		"@commitlint/config-conventional": "21.2.0",
		"lefthook": "2.1.10",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.6"
	}
}
