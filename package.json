{
	"name": "gwttr",
	"description": "Golang wttr.in client",
	"license": "GPL-3.0-only",
	"author": "Ryan Kes <ryan@ryankes.eu>",
	"scripts": {
		"format": "prettier --write",
		"format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
		"lint": "biome check",
		"lint:fix": "biome check --write --no-errors-on-unmatched",
		"md:lint": "markdownlint-cli2",
		"prepare": "lefthook install",
		"prose": "vale --no-exit --glob='!{styles/**,node_modules/**,CHANGELOG.md}'",
		"sort-package-json": "sort-package-json",
		"sort-package-json:check": "sort-package-json --check"
	},
	"overrides": {
		"fast-uri": "4.2.1",
		"js-yaml": "5.4.1",
		"katex": "0.19.0",
		"smol-toml": "1.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"lefthook": "2.2.2",
		"markdownlint-cli2": "0.24.0",
		"prettier": "3.9.10",
		"sort-package-json": "4.1.0"
	},
	"packageManager": "bun@1.3.14",
	"trustedDependencies": [
		"lefthook"
	]
}
